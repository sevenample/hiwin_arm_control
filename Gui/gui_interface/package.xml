<?xml version="1.0"?>
<package format="3">
  <name>gui_interface</name>
  <version>0.0.0</version>
  <description>PyQt5 GUI interface for order input and ROS2 publishing</description>
  <maintainer email="shaoan@todo.todo">shaoan</maintainer>
  <license>MIT-0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>hiwin_msgs</exec_depend>
  <exec_depend>PyQt5</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
